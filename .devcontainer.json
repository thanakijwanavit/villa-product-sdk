{
    // vps-4wr: no /var/run/docker.sock mount (it gave the container root on the host's Docker) and no appPort (it
    // published 4000 and 8080 on every interface); forwardPorts reaches them through the editor on localhost.
    "name": "nbdev_template-codespaces",
    "dockerComposeFile": "docker-compose.yml",
    "service": "watcher",
    "settings": {"terminal.integrated.shell.linux": "/bin/bash"},
    "forwardPorts": [4000, 8080],
    "extensions": ["ms-python.python",
                   "ms-azuretools.vscode-docker"],
    "runServices": ["notebook", "jekyll", "watcher"],
    "postStartCommand": "pip install -e ."
}
